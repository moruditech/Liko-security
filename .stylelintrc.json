{
  "extends": "stylelint-config-standard",
  "rules": {
    "custom-property-pattern": "^(liko|radius|space)-[a-z0-9-]+$",
    "declaration-property-value-disallowed-list": {
      "/color$/": ["/^#/", "/^rgb/", "/^hsl/"],
      "background-color": ["/^#/", "/^rgb/", "/^hsl/"],
      "border-color": ["/^#/", "/^rgb/", "/^hsl/"],
      "font-family": ["/Inter/", "/Roboto/", "/Arial/", "/Geist/", "/Space Grotesk/", "/Instrument Serif/"],
      "border-radius": ["/^(?!var\\().*(1[3-9]|[2-9][0-9])px/"]
    },
    "declaration-property-unit-disallowed-list": {
      "/^(margin|padding|gap|top|right|bottom|left)$/": ["px"]
    },
    "selector-class-pattern": null
  },
  "ignoreFiles": ["**/*.module.css.d.ts"]
}
