# Base URL of the backend API, including version prefix (env.js: API_VERSION defaults to "v1")
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# The public site's own canonical URL, used by app/sitemap.ts and app/robots.ts
# to build absolute URLs. Set to the real production domain before deploy.
NEXT_PUBLIC_SITE_URL=https://liko-security-training.example

# Must match FRONTEND_URL on the backend exactly, or CORS will reject credentialed
# requests (app.js only allows credentialed cross-origin requests from FRONTEND_URL).
# Backend's own default for FRONTEND_URL is http://localhost:5173 — confirm with
# whoever runs the backend locally, since Next.js's own dev default is :3000.
